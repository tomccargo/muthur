# Copy to .env (git-ignored) and fill in.

# TMDB: themoviedb.org -> Settings -> API -> "API Read Access Token".
# You can also enter it in muthur's Settings page instead.
TMDB_READ_TOKEN=

# ---- On the NAS (compose.yaml) ----
# The DSM user and group muthur runs as (see docs/DEPLOY.md for how to find them).
PUID=1026
PGID=100
# The shared folder holding torrent-output, TV and Film, and muthur's own config folder.
MEDIA_SHARE=/volume1/Iedereen
CONFIG_DIR=/volume1/docker/muthur/config
MUTHUR_PORT=8580
TZ=Europe/Brussels
