# Copy to .env (git-ignored) next to compose.yaml and fill in. These are the install's settings;
# everything else (Kodi, the TMDB token, languages, ...) is set in muthur's Settings page.

# The user and group muthur runs as: one without admin rights, that may write the media folder.
# `id <user>` on the NAS prints them, e.g. uid=1032(media) gid=100(users) -> PUID=1032, PGID=100.
PUID=
PGID=

# The folder that holds the downloads, TV and Film. One mount, so a move is an instant rename.
MEDIA_SHARE=/volume1/media
# Inside MEDIA_SHARE: finished downloads, the two libraries, and where muthur puts what it takes out.
DOWNLOADS_DIR=downloads/complete
TV_DIR=TV
FILM_DIR=Film
QUARANTINE_DIR=_muthur-quarantine

# muthur's own database and settings.
CONFIG_DIR=/volume1/docker/muthur/config

MUTHUR_PORT=8580
# Your time zone, for the times muthur shows: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC
# A fixed version instead of the newest, e.g. 0.21.0
MUTHUR_VERSION=latest

# Optional: the TMDB "API Read Access Token" (themoviedb.org -> Settings -> API). Can be entered in Settings instead.
TMDB_READ_TOKEN=

# ---- Only for running muthur on your own computer (scripts/dev.py, the command-line dry run) ----
# MUTHUR_CONFIG=local/config
# MUTHUR_DOWNLOADS=//nas/media/downloads/complete
# MUTHUR_TV=//nas/media/TV
# MUTHUR_FILM=//nas/media/Film
# MUTHUR_QUARANTINE=//nas/media/_muthur-quarantine
